# Copy to .env for local work. On the real site these are set in Netlify:
#   Site configuration → Environment variables
#
# .env is git-ignored. Never commit a key.

# ---- Supabase -------------------------------------------------------------
# Project → Settings → API

# The project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# The "anon" / publishable key. This one is MEANT to be in the browser — row-level security is
# what protects the data, not the secrecy of this key. The site fetches it from /api/status.
SUPABASE_ANON_KEY=

# The "service_role" key. This one is a master key: it ignores row-level security completely.
# It is used only by the audio functions, only on the server, and must never reach a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Claude ---------------------------------------------------------------
# Without it the site still works: Mia falls back to her offline vocabulary and says so. With it
# she talks about anything. https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Optional. The first model the account can actually use is the one that gets used; this only
# changes where the search starts.
# CLAUDE_MODEL=claude-opus-5
