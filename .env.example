# Скопируй в .env для локальной работы. На сайте те же значения задаются переменными окружения.
# .env в репозиторий не попадает.

# Адрес проекта базы и публичный ключ. Публичный — потому что он и должен быть в браузере:
# данные защищают правила доступа на строках, а не секретность этого ключа.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Служебный ключ. Обходит все правила доступа, живёт только внутри серверных функций
# и в браузер не попадает никогда.
SUPABASE_SERVICE_ROLE_KEY=

# Ключ Claude. Без него сайт работает: Мия отвечает из офлайн-словаря и честно об этом говорит.
# Необязателен и здесь — владелец может вставить его в панели на самом сайте.
ANTHROPIC_API_KEY=

# Кто админ. По умолчанию — владелец. Несколько адресов через запятую.
# OWNER_EMAILS=

# Необязательно: с какой модели начинать перебор.
# CLAUDE_MODEL=claude-opus-5
